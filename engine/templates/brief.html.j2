<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>1440 Intelligence Brief — {{ p.name }}</title>
<style>
  @page { size: A4; margin: 14mm 14mm 16mm 14mm; }
  * { box-sizing: border-box; }
  body { font-family: "Helvetica Neue", Arial, sans-serif; color: #14181f; margin: 0; font-size: 10.5px; line-height: 1.5; }
  .wrap { max-width: 820px; margin: 0 auto; }
  .topbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #14181f; padding-bottom: 6px; letter-spacing: .14em; font-size: 9px; text-transform: uppercase; }
  .brand { font-weight: 800; }
  .conf { color: #9aa0a6; }
  h1 { font-size: 30px; margin: 14px 0 2px; letter-spacing: -.5px; }
  .sub { color: #5f6671; font-size: 10px; letter-spacing: .04em; margin-bottom: 12px; }
  .lede { font-size: 13px; line-height: 1.45; font-weight: 600; border-left: 3px solid #d62128; padding-left: 12px; margin: 12px 0 16px; }
  .chips { display: flex; gap: 8px; margin: 14px 0; flex-wrap: wrap; }
  .chip { border: 1px solid #d7dbe0; border-radius: 4px; padding: 8px 10px; min-width: 96px; }
  .chip .k { font-size: 8px; text-transform: uppercase; letter-spacing: .12em; color: #8a9099; }
  .chip .v { font-size: 13px; font-weight: 800; margin-top: 2px; }
  .score-hero { background: #14181f; color: #fff; border-radius: 6px; padding: 12px 16px; display: flex; align-items: baseline; gap: 10px; }
  .score-hero .num { font-size: 40px; font-weight: 800; line-height: 1; }
  .score-hero .den { font-size: 13px; color: #aeb4bc; }
  .score-hero .lab { margin-left: auto; font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: #aeb4bc; }
  h2 { font-size: 11px; text-transform: uppercase; letter-spacing: .16em; border-bottom: 1px solid #e3e6ea; padding-bottom: 4px; margin: 18px 0 8px; color: #d62128; }
  p { margin: 0 0 9px; }
  .grid2 { display: flex; gap: 18px; }
  .grid2 > div { flex: 1; }
  .card { border: 1px solid #e3e6ea; border-radius: 6px; padding: 11px 13px; margin-bottom: 10px; }
  .card .name { font-weight: 800; font-size: 12px; }
  .card .role { color: #5f6671; font-size: 9.5px; margin-bottom: 6px; }
  .scoregrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .sc { border: 1px solid #e3e6ea; border-radius: 6px; padding: 9px 11px; }
  .sc .top { display: flex; justify-content: space-between; align-items: baseline; }
  .sc .pill { font-size: 9px; text-transform: uppercase; letter-spacing: .12em; color: #8a9099; }
  .sc .val { font-weight: 800; font-size: 15px; }
  .sc .why { font-size: 9.5px; color: #5f6671; margin-top: 3px; }
  .risk { margin-bottom: 9px; }
  .risk .rt { font-weight: 800; font-size: 9.5px; letter-spacing: .06em; }
  .risk .rd { color: #3a3f47; }
  .risk .rc { color: #0a7d3c; }
  .quote { background: #f6f7f9; border-radius: 6px; padding: 11px 14px; font-style: italic; font-size: 12px; }
  .footer { display: flex; justify-content: space-between; border-top: 1px solid #e3e6ea; margin-top: 16px; padding-top: 6px; font-size: 8.5px; color: #9aa0a6; letter-spacing: .08em; text-transform: uppercase; }
  .pagebreak { page-break-before: always; }
  .sources { font-size: 8.5px; color: #8a9099; }
  .sources li { margin-bottom: 2px; word-break: break-all; }
  .flag { display: inline-block; background: #fce8e9; color: #d62128; border-radius: 3px; padding: 2px 6px; font-size: 8px; text-transform: uppercase; letter-spacing: .08em; margin: 0 4px 4px 0; }
</style>
</head>
<body>
<div class="wrap">

  <div class="topbar">
    <span class="brand">1440 SPORTS</span>
    <span class="conf">Intelligence Brief · Confidential · N° {{ brief_no }}</span>
  </div>

  <h1>{{ p.name }}</h1>
  <div class="sub">{{ p.category }} · {{ p.hq }}{% if p.ticker %} · {{ p.ticker }}{% endif %} · {{ date }}</div>

  <div class="lede">{{ p.headline }}</div>

  <div class="score-hero">
    <span class="num">{{ p.opportunity }}</span><span class="den">/ 100</span>
    <span class="lab">Opportunity · {{ p.band }}</span>
  </div>

  <div class="chips">
    <div class="chip"><div class="k">Timing Window</div><div class="v">{{ p.timing_window }}</div></div>
    <div class="chip"><div class="k">Series</div><div class="v">{{ p.series }}</div></div>
    <div class="chip"><div class="k">Recommended Team</div><div class="v">{{ p.recommended_team }}</div></div>
    <div class="chip"><div class="k">Action Horizon</div><div class="v">{{ p.action_horizon }}</div></div>
    <div class="chip"><div class="k">Inbound Crowding</div><div class="v" style="font-size:10px">{{ p.crowding_label }}</div></div>
  </div>

  <div>
    {% for s in p.signals %}<span class="flag">{{ s.replace('_',' ') }}</span>{% endfor %}
  </div>

  <h2>The Case</h2>
  <p>{{ p.the_case }}</p>

  <h2>Why Now</h2>
  <p>{{ p.why_now }}</p>

  <div class="footer">
    <span>1440 Sports · London</span>
    <span>{{ p.name }} · {{ date }}</span>
    <span>1 / 2</span>
  </div>

  <div class="pagebreak"></div>
  <div class="topbar">
    <span class="brand">1440 SPORTS</span>
    <span class="conf">Intelligence Brief · Confidential · N° {{ brief_no }}</span>
  </div>

  <h2>Why {{ p.recommended_team }}</h2>
  <p>{{ p.why_team }}</p>

  <h2>Deal Architecture</h2>
  <p>{{ p.deal_architecture }}</p>

  <div class="grid2">
    <div>
      <h2>Primary Decision-Maker</h2>
      <div class="card">
        <div class="name">{{ p.decision_maker.name }}</div>
        <div class="role">{{ p.decision_maker.title }}</div>
        <div>{{ p.decision_maker.bio }}</div>
      </div>
    </div>
    <div>
      <h2>Opening Angle</h2>
      <div class="quote">{{ p.opening_angle }}</div>
    </div>
  </div>

  <h2>Score Composition</h2>
  <div class="scoregrid">
    {% for key, label in pillars %}
    <div class="sc">
      <div class="top"><span class="pill">{{ label }}</span><span class="val">{{ p.scores[key] }} / 25</span></div>
      <div class="why">{{ p.score_rationale[key] }}</div>
    </div>
    {% endfor %}
  </div>

  <h2>Risks &amp; Counters</h2>
  {% for r in p.risks %}
  <div class="risk">
    <span class="rt">{{ r.title }}</span>
    <span class="rd">{{ r.detail }}</span>
    <span class="rc"><strong>Counter:</strong> {{ r.counter }}</span>
  </div>
  {% endfor %}

  <h2>Sources</h2>
  <ul class="sources">
    {% for s in p.sources %}<li>{{ s }}</li>{% endfor %}
  </ul>

  <div class="footer">
    <span>1440 Sports · London</span>
    <span>{{ p.name }} · {{ date }}</span>
    <span>2 / 2</span>
  </div>

</div>
</body>
</html>
