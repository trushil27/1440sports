<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>1440 Intelligence Brief — {{ p.name }}</title>
<style>
  /* ===== 1440 Sports brand system (from CMYK logo + Ramp brief N025) ===== */
  :root {
    --navy: #191a48;        /* logo navy */
    --gold: #d1ae7a;        /* logo gold */
    --ink: #1a1c2e;
    --muted: #6b6e84;
    --hair: #e2e0ea;
    --paper: #ffffff;
    --panel: #f5f4f8;
  }
  @page {
    size: A4;
    margin: 10mm 12mm 9mm 12mm;
    @bottom-left   { content: "1440 SPORTS · LONDON"; font-family: Georgia, serif; font-size: 7pt; color: #9a98aa; letter-spacing: .12em; }
    @bottom-center { content: "{{ p.name|upper }} · {{ date_long }}"; font-family: Georgia, serif; font-size: 7pt; color: #9a98aa; letter-spacing: .12em; }
    @bottom-right  { content: counter(page) " / " counter(pages); font-family: Georgia, serif; font-size: 7pt; color: #9a98aa; letter-spacing: .12em; }
  }
  * { box-sizing: border-box; }
  body { font-family: Georgia, "Times New Roman", serif; color: var(--ink); margin: 0; font-size: 9pt; line-height: 1.36; }
  .wrap { max-width: 100%; }

  /* masthead */
  .mast { display: flex; justify-content: space-between; align-items: center; padding-bottom: 7px; border-bottom: 2px solid var(--navy); }
  .mast img { height: 21px; }
  .mast .meta { font-family: Arial, sans-serif; font-size: 6.6pt; letter-spacing: .19em; color: var(--muted); text-transform: uppercase; }
  .ribbon { font-family: Arial, sans-serif; font-size: 6.6pt; letter-spacing: .19em; color: var(--gold); text-transform: uppercase; margin: 9px 0 0; font-weight: 700; }

  h1 { font-size: 29pt; font-weight: 400; letter-spacing: -.5px; color: var(--navy); margin: 3px 0 1px; }
  .classline { font-size: 8.6pt; color: var(--muted); font-style: italic; margin-bottom: 7px; }
  .lede { font-size: 9.8pt; line-height: 1.4; color: var(--ink); margin: 0 0 9px; }
  .lede strong { color: var(--navy); }

  /* score + chips strip */
  .strip { display: flex; gap: 10px; align-items: stretch; margin: 3px 0 9px; }
  .scorebox { background: var(--navy); color: #fff; border-radius: 7px; padding: 11px 15px 9px; min-width: 118px; display: flex; flex-direction: column; justify-content: center; }
  .scorebox .num { font-size: 39pt; line-height: .9; font-weight: 700; }
  .scorebox .den { font-family: Arial, sans-serif; font-size: 6.4pt; letter-spacing: .19em; color: var(--gold); text-transform: uppercase; margin-top: 5px; }
  .chips { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; flex: 1; }
  .chip { border: 1px solid var(--hair); border-radius: 6px; padding: 7px 9px; display: flex; flex-direction: column; justify-content: center; }
  .chip .k { font-family: Arial, sans-serif; font-size: 6pt; letter-spacing: .14em; color: var(--muted); text-transform: uppercase; }
  .chip .v { font-family: Arial, sans-serif; font-size: 9.2pt; font-weight: 700; color: var(--navy); margin-top: 3px; line-height: 1.12; }
  .chip .v small { font-size: 6.6pt; font-weight: 700; color: var(--gold); display:block; letter-spacing:.08em; }

  h2 { font-family: Arial, sans-serif; font-size: 7.2pt; text-transform: uppercase; letter-spacing: .16em; color: var(--gold); border-bottom: 1px solid var(--hair); padding-bottom: 2px; margin: 8px 0 4px; font-weight: 700; }
  p { margin: 0 0 5px; }
  .twocol { display: flex; gap: 16px; }
  .twocol > div { flex: 1; }

  .dm { border: 1px solid var(--hair); border-radius: 6px; padding: 7px 10px; }
  .dm .name { font-size: 11pt; color: var(--navy); }
  .dm .role { font-family: Arial, sans-serif; font-size: 6.8pt; color: var(--muted); text-transform: uppercase; letter-spacing: .07em; margin-bottom: 4px; }
  .dm .bio { font-size: 8.2pt; line-height: 1.3; }
  .quote { background: var(--panel); border-left: 3px solid var(--gold); border-radius: 0 6px 6px 0; padding: 8px 11px; font-style: italic; font-size: 9.2pt; color: var(--navy); line-height: 1.34; }

  .scoregrid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
  .sc { border: 1px solid var(--hair); border-radius: 6px; padding: 5px 7px; }
  .sc .pill { font-family: Arial, sans-serif; font-size: 6pt; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); }
  .sc .val { font-family: Arial, sans-serif; font-size: 11.5pt; font-weight: 700; color: var(--navy); }
  .sc .val span { font-size: 7pt; color: var(--muted); font-weight: 400; }
  .sc .why { font-size: 7.1pt; color: #4a4c63; margin-top: 2px; line-height: 1.26; }

  .risk { margin-bottom: 4px; font-size: 8.4pt; line-height: 1.32; }
  .risk .rt { font-family: Arial, sans-serif; font-weight: 700; font-size: 7.4pt; letter-spacing: .05em; color: var(--navy); text-transform: uppercase; }
  .risk .rc { color: var(--navy); }
  .risk .rc b { color: var(--gold); }

  .flags { margin: 5px 0 0; }
  .flag { display: inline-block; font-family: Arial, sans-serif; background: #f0eef6; color: var(--navy); border: 1px solid var(--hair); border-radius: 3px; padding: 2px 6px; font-size: 6.4pt; text-transform: uppercase; letter-spacing: .06em; margin: 0 4px 4px 0; }
  .sources { font-size: 6.8pt; color: var(--muted); margin: 4px 0 0; padding-left: 14px; }
  .sources li { margin-bottom: 1px; }
  .page2 { page-break-before: always; }
  .mode { font-family: Arial, sans-serif; font-size: 6.6pt; letter-spacing: .06em; color: var(--muted); }
  .mode b { color: var(--navy); }
</style>
</head>
<body>
<div class="wrap">

  <!-- ===================== PAGE 1 ===================== -->
  <div class="mast">
    <img src="{{ logo_navy }}" alt="1440 Sports">
    <span class="meta">Intelligence Brief · Confidential · N° {{ brief_no }}</span>
  </div>
  <div class="ribbon">Intelligence Brief / N° {{ brief_no }} &nbsp;·&nbsp; {{ p.tier }}</div>

  <h1>{{ p.name }}</h1>
  <div class="classline">{{ p.category }} · {{ p.hq }}{% if p.ticker %} · {{ p.ticker }}{% endif %}</div>

  <div class="lede">{{ p.headline_long }}</div>

  <div class="strip">
    <div class="scorebox"><div class="num">{{ p.opportunity }}</div><div class="den">Opportunity / 100</div></div>
    <div class="chips">
      <div class="chip"><div class="k">Timing Window</div><div class="v">{{ p.timing_window }}</div></div>
      <div class="chip"><div class="k">Series</div><div class="v">{{ p.series }}</div></div>
      <div class="chip"><div class="k">Recommended Team</div><div class="v">{{ p.recommended_team }}</div></div>
      <div class="chip"><div class="k">Action Horizon</div><div class="v">{{ p.action_horizon }}</div></div>
    </div>
  </div>

  <h2>The Case</h2>
  <p>{{ p.the_case }}</p>

  <h2>Why Now</h2>
  <p>{{ p.why_now }}</p>

  <div class="flags">
    {% for s in p.signals %}<span class="flag">{{ s.replace('_',' ') }}</span>{% endfor %}
    <span class="flag">discovery: {{ p.discovery }}</span>
  </div>

  <!-- ===================== PAGE 2 ===================== -->
  <div class="page2"></div>
  <div class="mast">
    <img src="{{ logo_navy }}" alt="1440 Sports">
    <span class="meta">Intelligence Brief · Confidential · N° {{ brief_no }}</span>
  </div>

  <h2>Why {{ p.recommended_team }}</h2>
  <p>{{ p.why_team }}</p>

  <h2>Value to {{ p.recommended_team }} &nbsp;<span class="mode">— <b>MODE {{ p.mode }}</b> ({{ 'tech in the car / championship' if p.mode == 'A' else 'tech serves the team operation' }})</span></h2>
  <p>{{ p.value_to_team }}</p>

  <h2>Deal Architecture</h2>
  <p>{{ p.deal_architecture }}</p>

  <div class="twocol">
    <div>
      <h2>Primary Decision-Maker</h2>
      <div class="dm">
        <div class="name">{{ p.decision_maker.name }}</div>
        <div class="role">{{ p.decision_maker.title }}</div>
        <div class="bio">{{ p.decision_maker.bio }}</div>
      </div>
    </div>
    <div>
      <h2>Opening Angle</h2>
      <div class="quote">{{ p.opening_angle }}</div>
    </div>
  </div>

  <h2>Score Composition</h2>
  <div class="scoregrid">
    {% for key, label in pillars %}
    <div class="sc">
      <div class="pill">{{ label }}</div>
      <div class="val">{{ p.scores[key] }} <span>/ 20</span></div>
      <div class="why">{{ p.score_rationale[key] }}</div>
    </div>
    {% endfor %}
  </div>

  <h2>Risks &amp; Counters</h2>
  {% for r in p.risks %}
  <div class="risk"><span class="rt">{{ r.title }}</span> &nbsp;<span class="rc">{{ r.detail }} <b>Counter:</b> {{ r.counter }}</span></div>
  {% endfor %}

  <h2>Sources</h2>
  <ul class="sources">
    {% for s in p.sources %}<li>{{ s }}</li>{% endfor %}
  </ul>
</div>
</body>
</html>
