<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>1440 Intelligence Brief — {{ company }}</title>
<style>
  /* ===== 1440 Sports brand system — June-2026 production format (Ramp N° 007/017) ===== */
  {% if font_stack == 'brand' %}
  @font-face { font-family: 'Lora'; src: url('{{ fonts_dir }}/Lora-Variable.ttf'); font-weight: 400 700; font-style: normal; }
  @font-face { font-family: 'Lora'; src: url('{{ fonts_dir }}/Lora-Italic-Variable.ttf'); font-weight: 400 700; font-style: italic; }
  @font-face { font-family: 'Poppins'; src: url('{{ fonts_dir }}/Poppins-Regular.ttf'); font-weight: 400; }
  @font-face { font-family: 'Poppins'; src: url('{{ fonts_dir }}/Poppins-Medium.ttf'); font-weight: 500; }
  @font-face { font-family: 'Poppins'; src: url('{{ fonts_dir }}/Poppins-Bold.ttf'); font-weight: 700; }
  @font-face { font-family: 'Poppins'; src: url('{{ fonts_dir }}/Poppins-Light.ttf'); font-weight: 300; }
  :root { --serif: 'Lora', Georgia, serif; --sans: 'Poppins', Arial, sans-serif; }
  {% else %}
  :root { --serif: Georgia, "Liberation Serif", "Times New Roman", serif; --sans: Arial, "Liberation Sans", sans-serif; }
  {% endif %}
  :root {
    --navy: #191a48;        /* logo navy */
    --gold: #d1ae7a;        /* logo gold */
    --ink: #1a1c2e;
    --muted: #6b6e84;
    --hair: #e2e0ea;
    --paper: #ffffff;
    --panel: #f5f4f8;
  }
  @page {
    size: A4;
    margin: 10mm 12mm 9mm 12mm;
    @bottom-left   { content: "{{ footer_left }}"; font-family: {{ page_font|safe }}; font-size: 7pt; color: #9a98aa; letter-spacing: .12em; }
    @bottom-center { content: "{{ footer_company }} · {{ footer_date }}"; font-family: {{ page_font|safe }}; font-size: 7pt; color: #9a98aa; letter-spacing: .12em; }
    @bottom-right  { content: counter(page) " / " counter(pages); font-family: {{ page_font|safe }}; font-size: 7pt; color: #9a98aa; letter-spacing: .12em; }
  }
  * { box-sizing: border-box; }
  body { font-family: var(--serif); color: var(--ink); margin: 0; font-size: 9pt; line-height: 1.36; background: var(--paper); }
  .wrap { max-width: 100%; }

  /* masthead */
  .mast { display: flex; justify-content: space-between; align-items: center; padding-bottom: 7px; border-bottom: 2px solid var(--navy); }
  .mast img { height: 21px; }
  .mast .meta { font-family: var(--sans); font-size: 6.6pt; letter-spacing: .19em; color: var(--muted); text-transform: uppercase; }
  .ribbon { font-family: var(--sans); font-size: 6.6pt; letter-spacing: .19em; color: var(--gold); text-transform: uppercase; margin: 9px 0 0; font-weight: 700; }

  h1 { font-size: 29pt; font-weight: 400; letter-spacing: -.5px; color: var(--navy); margin: 3px 0 1px; }
  .classline { font-size: 8.6pt; color: var(--muted); font-style: italic; margin-bottom: 7px; }
  .lede { font-size: 9.8pt; line-height: 1.4; color: var(--ink); margin: 0 0 9px; }
  .lede b, .hl { color: var(--navy); font-family: var(--sans); font-size: 8.6pt; letter-spacing: .02em; }

  /* score + chips strip */
  .strip { display: flex; gap: 10px; align-items: stretch; margin: 3px 0 9px; }
  .scorebox { background: var(--navy); color: #fff; border-radius: 7px; padding: 11px 15px 9px; min-width: 118px; display: flex; flex-direction: column; justify-content: center; }
  .scorebox .num { font-size: 39pt; line-height: .9; font-weight: 700; }
  .scorebox .den { font-family: var(--sans); font-size: 6.4pt; letter-spacing: .19em; color: var(--gold); text-transform: uppercase; margin-top: 5px; }
  .chips { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; flex: 1; }
  .chip { border: 1px solid var(--hair); border-radius: 6px; padding: 7px 9px; display: flex; flex-direction: column; justify-content: center; }
  .chip .k { font-family: var(--sans); font-size: 6pt; letter-spacing: .14em; color: var(--muted); text-transform: uppercase; }
  .chip .v { font-family: var(--sans); font-size: 9.2pt; font-weight: 700; color: var(--navy); margin-top: 3px; line-height: 1.12; }

  h2 { font-family: var(--sans); font-size: 7.2pt; text-transform: uppercase; letter-spacing: .16em; color: var(--gold); border-bottom: 1px solid var(--hair); padding-bottom: 2px; margin: 8px 0 4px; font-weight: 700; }
  p { margin: 0 0 5px; }
  .twocol { display: flex; gap: 16px; }
  .twocol > div { flex: 1; }

  .dm { border: 1px solid var(--hair); border-radius: 6px; padding: 7px 10px; }
  .dm .name { font-size: 11pt; color: var(--navy); }
  .dm .role { font-family: var(--sans); font-size: 6.8pt; color: var(--muted); text-transform: uppercase; letter-spacing: .07em; margin-bottom: 4px; }
  .dm .role .vtag { color: #2f7d4f; font-weight: 700; }
  .dm .role .utag { color: #9a6b1f; font-weight: 700; }
  .dm .bio { font-size: 8.2pt; line-height: 1.3; }
  .quote { background: var(--panel); border-left: 3px solid var(--gold); border-radius: 0 6px 6px 0; padding: 8px 11px; font-style: italic; font-size: 9.2pt; color: var(--navy); line-height: 1.34; }
  .intro { font-size: 8.4pt; color: var(--ink); margin-bottom: 5px; }

  .scoregrid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
  .sc { border: 1px solid var(--hair); border-radius: 6px; padding: 5px 7px; }
  .sc .pill { font-family: var(--sans); font-size: 6pt; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); }
  .sc .val { font-family: var(--sans); font-size: 11.5pt; font-weight: 700; color: var(--navy); }
  .sc .val span { font-size: 7pt; color: var(--muted); font-weight: 400; }
  .sc .why { font-size: 7.1pt; color: #4a4c63; margin-top: 2px; line-height: 1.26; }

  .risk { margin-bottom: 4px; font-size: 8.4pt; line-height: 1.32; }
  .risk .rt { font-family: var(--sans); font-weight: 700; font-size: 7.4pt; letter-spacing: .05em; color: var(--navy); text-transform: uppercase; }
  .risk .rc { color: var(--navy); }
  .risk .rc b { color: var(--gold); }

  /* page-1 proof points (from the claims ledger) */
  .proof { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; margin-top: 2px; }
  .pf { border: 1px solid var(--hair); border-radius: 6px; padding: 7px 9px; background: var(--panel); }
  .pf .pfv { font-size: 12.5pt; font-weight: 700; color: var(--navy); line-height: 1.05; }
  .pf .pfv .dag { color: #9a6b1f; font-size: 8pt; vertical-align: super; }
  .pf .pfk { font-family: var(--sans); font-size: 6.6pt; color: var(--muted); letter-spacing: .03em; margin-top: 4px; line-height: 1.22; }

  /* page-1 grid-fit (category whitespace, computed from the sponsors table) */
  .gf { margin-top: 2px; }
  .gfrow { display: grid; grid-template-columns: 118px 74px 1fr; align-items: center; gap: 9px; padding: 4px 0; border-bottom: 1px solid var(--hair); }
  .gfrow:last-child { border-bottom: 0; }
  .gft { font-size: 8.8pt; color: var(--navy); font-weight: 700; }
  .gft .gfstar { font-family: var(--sans); font-size: 5.8pt; font-weight: 700; letter-spacing: .1em; color: var(--gold); display: block; margin-top: 1px; }
  .gflab { font-family: var(--sans); font-size: 6.4pt; font-weight: 700; letter-spacing: .1em; text-align: center; padding: 3px 0; border-radius: 4px; text-transform: uppercase; }
  .gflab.prime { background: var(--navy); color: var(--gold); border: 1px solid var(--navy); }
  .gflab.open { background: #eaf4ec; color: #2f7d4f; border: 1px solid #cfe6d6; }
  .gflab.crowded { background: #fbf3e6; color: #9a6b1f; border: 1px solid #efe0c4; }
  .gflab.conflict { background: #f7eaea; color: #9a2f2f; border: 1px solid #ecd2d2; }
  .gfrow.rec { background: #fbf8f1; border-radius: 6px; }
  .gfd { font-size: 7.4pt; color: #4a4c63; line-height: 1.22; }
  .panelnote { font-family: var(--sans); font-size: 6.2pt; color: var(--muted); letter-spacing: .03em; margin: 2px 0 0; font-style: normal; }
  .panelnote.warn { color: #9a6b1f; }

  .bottomline { margin: 10px 0 0; background: var(--navy); border-left: 4px solid var(--gold); border-radius: 0 6px 6px 0; padding: 9px 13px; color: #fff; }
  .bottomline .bl-k { font-family: var(--sans); font-size: 6.4pt; font-weight: 700; letter-spacing: .18em; color: var(--gold); text-transform: uppercase; }
  .bottomline .bl-t { font-size: 9.6pt; line-height: 1.36; margin-top: 3px; color: #f3f1ea; }
  .bottomline .hl { color: var(--gold); }

  .flags { margin: 5px 0 0; }
  .flag { display: inline-block; font-family: var(--sans); background: #f0eef6; color: var(--navy); border: 1px solid var(--hair); border-radius: 3px; padding: 2px 6px; font-size: 6.4pt; text-transform: uppercase; letter-spacing: .06em; margin: 0 4px 4px 0; }
  .sources { font-size: 6.8pt; color: var(--muted); margin: 4px 0 0; padding-left: 14px; }
  .sources li { margin-bottom: 1px; }
  .page2 { page-break-before: always; }
  .mode { font-family: var(--sans); font-size: 6.6pt; letter-spacing: .06em; color: var(--muted); }
  .mode b { color: var(--navy); }
</style>
</head>
<body>
<div class="wrap">

  <!-- ===================== PAGE 1 ===================== -->
  <div class="mast">
    <img src="{{ logo_src }}" alt="1440 Sports">
    <span class="meta">Intelligence Brief · Confidential · N° {{ brief_number }}</span>
  </div>
  <div class="ribbon">Intelligence Brief / N° {{ brief_number }}{{ track_label }} &nbsp;·&nbsp; {{ tier }}</div>

  <h1>{{ company }}</h1>
  <div class="classline">{{ industry_meta }}{% if hq %} · {{ hq }}{% endif %}{% if ticker %} · {{ ticker }}{% endif %}</div>

  <div class="lede">{{ deck_html }}</div>

  <div class="strip">
    <div class="scorebox"><div class="num">{{ score }}</div><div class="den">Opportunity / 100</div></div>
    <div class="chips">
      <div class="chip"><div class="k">Timing Window</div><div class="v">{{ timing_label }}</div></div>
      <div class="chip"><div class="k">Series</div><div class="v">{{ series_label }}</div></div>
      <div class="chip"><div class="k">Recommended Team</div><div class="v">{{ team_label }}</div></div>
      <div class="chip"><div class="k">Action Horizon</div><div class="v">{{ horizon_label }}</div></div>
    </div>
  </div>

  <h2>The Case</h2>
  <p>{{ the_case_p1_html }}</p>
  {% if the_case_p2 %}<p>{{ the_case_p2_html }}</p>{% endif %}

  <h2>Why Now</h2>
  <p>{{ why_now_html }}</p>

  {% if proof_points %}
  <h2>Proof Points
    {% if all_proof_points_verified %}<span class="panelnote">— every figure verified to a primary source (see p.2)</span>
    {% else %}<span class="panelnote warn">— † not yet verified to a primary source · verify before circulation</span>{% endif %}
  </h2>
  <div class="proof">
    {% for pf in proof_points[:6] %}
    <div class="pf"><div class="pfv">{{ pf.value }}{% if not pf.verified %}<span class="dag">†</span>{% endif %}</div><div class="pfk">{{ pf.fact }}</div></div>
    {% endfor %}
  </div>
  {% endif %}

  {% if gridfit %}
  <h2>Grid Fit <span class="panelnote">— category-whitespace check across the {{ series_label }} grid (sponsor table{% if gridfit_note %}; {{ gridfit_note }}{% endif %})</span></h2>
  <div class="gf">
    {% for row in gridfit %}
    <div class="gfrow {{ 'rec' if row.recommended }}">
      <div class="gft">{{ row.team }}{% if row.recommended %}<span class="gfstar">◆ RECOMMENDED</span>{% endif %}</div>
      <div class="gflab {{ row.status }}">{{ row.label }}</div>
      <div class="gfd">{{ row.detail }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if bottom_line %}
  <div class="bottomline">
    <div class="bl-k">Bottom Line</div>
    <div class="bl-t">{{ bottom_line_html }}</div>
  </div>
  {% endif %}

  <div class="flags">
    {% for s in signals %}<span class="flag">{{ s.replace('_',' ') }}</span>{% endfor %}
    <span class="flag">discovery: {{ discovery }}</span>
  </div>

  <!-- ===================== PAGE 2 ===================== -->
  <div class="page2"></div>
  <div class="mast">
    <img src="{{ logo_src }}" alt="1440 Sports">
    <span class="meta">Intelligence Brief · Confidential · N° {{ brief_number }}</span>
  </div>

  <h2>{{ why_team_label }}</h2>
  <p>{{ why_team_para_html }}</p>

  {% if value_section and value_content %}
  <h2>{{ value_section_label }} &nbsp;<span class="mode">— <b>MODE {{ value_mode }}</b> ({{ mode_caption }})</span></h2>
  <p>{{ value_content_html }}</p>
  {% endif %}

  <h2>Deal Architecture</h2>
  <p>{{ deal_arch_para_html }}</p>

  <div class="twocol">
    <div>
      <h2>Primary Decision-Maker</h2>
      <div class="dm">
        <div class="name">{{ decision_maker_name }}</div>
        <div class="role">{{ decision_maker_role }}{% if decision_maker_verified %} · <span class="vtag">verified</span>{% else %} · <span class="utag">role not yet verified</span>{% endif %}</div>
        <div class="bio">{{ decision_maker_bio_html }}</div>
      </div>
    </div>
    <div>
      <h2>Opening Angle</h2>
      {% if opening_angle_intro %}<div class="intro">{{ opening_angle_intro_html }}</div>{% endif %}
      <div class="quote">{{ opening_angle_quote_html }}</div>
    </div>
  </div>

  <h2>Score Composition</h2>
  <div class="scoregrid">
    {% for c in score_cells %}
    <div class="sc">
      <div class="pill">{{ c.label }}</div>
      <div class="val">{{ c.num }} <span>{{ c.denom }}</span></div>
      <div class="why">{{ c.note }}</div>
    </div>
    {% endfor %}
  </div>

  <h2>Risks &amp; Counters</h2>
  {% for r in risks_html %}
  <div class="risk"><span class="rt">{{ r.label }}</span> &nbsp;<span class="rc">{{ r.detail }} <b>Counter:</b> {{ r.counter }}</span></div>
  {% endfor %}

  <h2>Sources <span class="panelnote">— {{ claims_verified }} of {{ claims_total }} load-bearing claims verified</span></h2>
  <ul class="sources">
    {% for s in sources %}<li>{{ s }}</li>{% endfor %}
  </ul>
</div>
</body>
</html>
